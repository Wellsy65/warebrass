{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warebrass",
  "compatibility_date": "2026-10-18",
  "routes": [
    {
      "pattern": "test.warebrass.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
